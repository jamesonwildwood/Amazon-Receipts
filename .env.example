# Amazon — copy amazon_accounts.toml.example to amazon_accounts.toml instead
# (chmod 600) and fill in there; it supports multiple accounts. These env
# vars are legacy back-compat only: if amazon_accounts.toml is absent and
# these are set, they're synthesized into a single account labeled "default".
# If both are present, the toml wins and a warning is logged.
AMAZON_EMAIL=
AMAZON_PASSWORD=
AMAZON_TOTP_SECRET=
AMAZON_ACCOUNTS_PATH=./amazon_accounts.toml

# YNAB
YNAB_PERSONAL_ACCESS_TOKEN=
YNAB_BUDGET_ID=last-used
YNAB_ACCOUNT_ID=
YNAB_MATCH_WINDOW_DAYS=10
YNAB_ONLY_MATCH_UNCATEGORIZED=true
# Off by default: allow creating a brand-new transaction for orders with no
# bank-fed match, instead of leaving them at no_candidate. Explicit opt-in only.
YNAB_ALLOW_CREATE_WITHOUT_MATCH=false
YNAB_AMAZON_PAYEE_FILTERS=Amazon,AMZN

# LLM — pluggable: "anthropic" or "openai_compatible" (e.g. a local Ollama/vLLM server)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=llama3.1

# Scraper
SELENIUM_REMOTE_URL=
SCRAPE_HEADLESS=true

# Dev-only safety bypasses — leave false in whatever .env backs the scheduled/production run
ALLOW_RESET=false
ALLOW_REAPPLY=false

# Notifications — off by default (empty NOTIFY_SMTP_HOST = disabled). Works
# with a Gmail app password: smtp.gmail.com, port 587, the 16-char app
# password (not your normal Gmail password) as NOTIFY_SMTP_PASSWORD. See the
# README's Notifications section for the setup link.
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_DASHBOARD_URL=http://localhost:8420

# App
PIPELINE_SCHEDULE_CRON=0 7 * * *
DATABASE_PATH=./data/app.db
RECEIPTS_DIR=./data/receipts_html
DASHBOARD_PORT=8420
LOG_LEVEL=INFO
